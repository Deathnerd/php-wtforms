parameters:
	ignoreErrors:
		-
			message: '#^Method WTForms\\Form\:\:create\(\) should return static\(WTForms\\Form\<TMeta of WTForms\\DefaultMeta\>\) but returns static\(WTForms\\Form\<WTForms\\DefaultMeta\>\)\.$#'
			identifier: return.type
			count: 1
			path: src/Form.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Form.php

		# PHPStan suppress needed for argument.type on line 62 of SelectFieldBase
		-
			message: '#^Parameter \#1 \$opts of class WTForms\\Fields\\Core\\_Option constructor expects array\{.*\}, array\{.*\} given\.$#'
			identifier: argument.type
			count: 1
			path: src/Fields/Core/SelectFieldBase.php