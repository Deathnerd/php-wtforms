parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - vendor
    treatPhpDocTypesAsCertain: false

    exceptions:
        uncheckedExceptionClasses:
            - WTForms\Exceptions\StopValidation
            - WTForms\Exceptions\ValidationError

includes:
#    - phpstan-baseline.neon
    - phpstan/extension.neon
