{
  "name": "deathnerd/php-wtforms",
  "description": "A PHP rewrite of the fantastic Python library WTForms",
  "type": "library",
  "version": "0.5.2",
  "license": "GPL-2.0",
  "authors": [
    {
      "name": "Wes Gilleland",
      "email": "wes.gilleland@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "WTForms\\": "src/",
      "WTForms\\Internal\\": "src/Internal/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WTForms\\Tests\\": "tests/",
      "WTForms\\PHPStan\\": "phpstan/"
    }
  },
  "require": {
    "php": ">=7.4",
    "nesbot/carbon": "^2.0 || ^3.0",
    "gettext/gettext": "^5.7",
    "gettext/translator": "^1.2",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "rector/rector": "^2.3",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.93"
  },
  "scripts": {
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "format:fix": "php-cs-fixer fix",
    "test": "phpunit",
    "analyze": "phpstan analyse"
  }
}
